{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "hud-ui",
  "homepage": "https://github.com/um1chc5/hud-ui",
  "items": [
    {
      "name": "hud-theme",
      "type": "registry:style",
      "title": "HUD Theme",
      "description": "CSS tokens for steel, teal, thermal, and day palettes plus chamfer, glow, scrollbar, and motion chrome.",
      "files": [
        {
          "source": "packages/ui/src/styles/tokens.css",
          "path": "styles/hud-tokens.css",
          "target": "src/styles/hud-tokens.css",
          "type": "registry:file"
        },
        {
          "source": "packages/ui/src/styles/hud.css",
          "path": "styles/hud.css",
          "target": "src/styles/hud.css",
          "type": "registry:file"
        },
        {
          "source": "packages/ui/src/lib/tokens.ts",
          "path": "lib/tokens.ts",
          "type": "registry:lib"
        }
      ],
      "docs": "Import `./styles/hud-tokens.css` and `./styles/hud.css` at your app root and set data-hud-palette, data-hud-glow, data-hud-motion, and data-hud-grid on <html>."
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Class Utils",
      "description": "cn() helper combining clsx and tailwind-merge.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "source": "packages/ui/src/lib/utils.ts",
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "hud-hooks",
      "type": "registry:hook",
      "title": "HUD Motion Hooks",
      "description": "Hooks tracking OS prefers-reduced-motion and <html data-hud-motion>.",
      "files": [
        {
          "source": "packages/ui/src/hooks/usePrefersReducedMotion.ts",
          "path": "hooks/usePrefersReducedMotion.ts",
          "type": "registry:hook"
